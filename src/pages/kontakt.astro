---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { site, withBase } from '@/data/site';
---
<BaseLayout title="Kontakt | Kulignum Holzbau" description="Kontakt zu Kulignum Holzbau in Altlußheim: Telefon, E-Mail, Adresse und Anfrageformular.">
  <PageHero title="Kontakt" description="Was können wir für Sie tun?" eyebrow="Kontakt" />
  <section class="section">
    <div class="container">
      <div class="contact-cards">
        <article class="contact-card"><h3>Adresse</h3><p>{site.address}</p><p>{site.addressNote}</p></article>
        <article class="contact-card"><h3>Telefon</h3><p><a href={`tel:${site.phoneCompact.replaceAll(' ', '')}`}>{site.phone}</a></p></article>
        <article class="contact-card"><h3>E-Mail</h3><p><a href={`mailto:${site.email}`}>{site.email}</a></p></article>
      </div>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container grid grid--2">
      <article class="content">
        <span class="eyebrow">Anfrage</span>
        <h2>Schreiben Sie uns</h2>
        <form class="form" name="kontakt" method="post" action={withBase('success/')} netlify-honeypot="bot-field" netlify>
          <input type="hidden" name="bot-field" />
          <input type="hidden" name="form-name" value="kontakt" />
          
          <label>Name<input required name="name" type="text" autocomplete="name" /></label>
          <label>E-Mail<input required name="email" type="email" autocomplete="email" /></label>
          <label>Telefon <span style="color: var(--color-muted);">(optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
          <label>Betreff <span style="color: var(--color-muted);">(optional)</span><input name="subject" type="text" placeholder="z.B. Anfrage zu Holzbau" /></label>
          <label>Nachricht<textarea required name="message" placeholder="Erzählen Sie uns von Ihrem Projekt..."></textarea></label>
          
          <label class="checkbox">
            <input required name="privacy" type="checkbox" />
            <span>Ich habe die <a href={withBase('datenschutz/')}>Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Angaben zu.</span>
          </label>
          
          <button class="btn" type="submit">Nachricht absenden</button>
        </form>
      </article>
      <aside class="map-placeholder">
        <div>
          <h3>Karte anzeigen</h3>
          <p>Aus Datenschutzgründen wird die Karte erst nach Ihrer Zustimmung geladen.</p>
          <button class="btn btn--ghost" type="button">Karte anzeigen</button>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
